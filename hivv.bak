#!/usr/bin/env bash
# hivv — minimal launcher for the HIVV.org client CLI.
# Downloads + installs the client on first run, then execs it.
# Self-heals: re-downloads if the local CLI is broken or argparse crashes.
#
# Usage:
#   hivv --help
#   hivv start
#   hivv chat "hello world"
#
# This file is served at https://hivv.org/hivv and is the canonical
# way to invoke the CLI. It is also installed by install-hivv.sh.
set -euo pipefail

SELF="${BASH_SOURCE[0]:-$0}"
if [[ -L "$SELF" ]]; then SELF="$(readlink -f "$SELF" 2>/dev/null || readlink "$SELF")"; fi
SELF_DIR="$(cd "$(dirname "$SELF")" 2>/dev/null && pwd || echo "$(dirname "$SELF")")"

case "$SELF_DIR" in
    */bin) PARENT_LIB="${SELF_DIR%/bin}/lib/hivv" ;;
    *)     PARENT_LIB="$SELF_DIR" ;;
esac

CLIENT_URL="${HIVV_CLIENT_URL:-https://hivv.org/hivv-cli.py}"
CLIENT_FILE="${HIVV_CLIENT_FILE:-$PARENT_LIB/hivv-cli.py}"

need_python() {
    if ! command -v python3 >/dev/null 2>&1; then
        echo "[hivv] python3 not found. install it (apt install python3 / brew install python3)" >&2
        exit 1
    fi
}

need_curl_or_wget() {
    if ! command -v curl >/dev/null 2>&1 && ! command -v wget >/dev/null 2>&1; then
        echo "[hivv] need curl or wget to download the client" >&2
        exit 1
    fi
}

download_client() {
    need_curl_or_wget
    mkdir -p "$(dirname "$CLIENT_FILE")" 2>/dev/null || {
        echo "[hivv] cannot write to $(dirname "$CLIENT_FILE")" >&2
        echo "[hivv] try: curl -sSL https://hivv.org/install-hivv.sh | bash" >&2
        exit 1
    }
    echo "[hivv] fetching fresh client from $CLIENT_URL" >&2
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL "$CLIENT_URL" -o "$CLIENT_FILE" || {
            echo "[hivv] download failed" >&2
            exit 1
        }
    else
        wget -qO "$CLIENT_FILE" "$CLIENT_URL" || {
            echo "[hivv] download failed" >&2
            exit 1
        }
    fi
    chmod 0755 "$CLIENT_FILE"
}

is_cli_broken() {
    local output
    # Capture both stdout and stderr from a simple invocation
    output=$(python3 "$CLIENT_FILE" --help 2>&1) || true
    # Broken CLI shows: Traceback, ValueError, argparse errors, SyntaxError, ImportError
    if echo "$output" | grep -qiE "Traceback|ValueError|SyntaxError|ImportError"; then
        return 0  # 0 = yes, broken
    fi
    # Also check if --help itself crashes (the specific argparse %% bug)
    if echo "$output" | grep -qi "argparse\|unsupported format character"; then
        return 0
    fi
    return 1  # not broken
}

need_python

# First run: if client doesn't exist, download it
if [[ ! -f "$CLIENT_FILE" ]]; then
    download_client
fi

# Check if CLI is broken before trying to run it
if is_cli_broken; then
    echo "[hivv] local CLI appears broken — re-downloading fresh copy..." >&2
    download_client
fi

python3 "$CLIENT_FILE" "$@"
